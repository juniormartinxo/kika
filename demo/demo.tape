# Records assets/demo.gif. Run from the repository root:
#   vhs demo/demo.tape

Output assets/demo.gif

Set Shell bash
Set FontSize 16
Set Width 1180
Set Height 560
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms
Set WindowBar Colorful
Set BorderRadius 10

Hide
Type "source demo/setup.sh && clear"
Enter
Sleep 1s
Show

Sleep 600ms
Type "kika"
Sleep 400ms
Enter
Sleep 4s

# Mark two projects
Down
Sleep 500ms
Space
Sleep 700ms
Down
Sleep 400ms
Down
Sleep 500ms
Space
Sleep 1s

# Clean the selection
Type "c"
Sleep 2s
Type "y"
Sleep 6s
